  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inconsistency window saw-tooth (MUST move — a flat ~0 is the push-time-delta bug)",
      "gridPos": { "h": 10, "w": 18, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "spanNulls": true, "pointSize": 6, "showPoints": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "10s trigger" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [8, 4], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "30s alert (3× trigger)" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - payments_cdc_last_ledger_commit_timestamp_seconds",
          "legendFormat": "inconsistency window"
        },
        { "refId": "B", "expr": "vector(10)", "legendFormat": "10s trigger" },
        { "refId": "C", "expr": "vector(30)", "legendFormat": "30s alert (3× trigger)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current window (s)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 12 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - payments_cdc_last_ledger_commit_timestamp_seconds",
          "legendFormat": "window"
        }
      ]
    },
