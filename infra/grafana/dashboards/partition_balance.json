          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(payments_cdc_topic_end_offset - payments_cdc_processed_offset)",
          "legendFormat": "max lag"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Lag spread (max − min) — hot partition detector",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(payments_cdc_topic_end_offset - payments_cdc_processed_offset) - min(payments_cdc_topic_end_offset - payments_cdc_processed_offset)",
